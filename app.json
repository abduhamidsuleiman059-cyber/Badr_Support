{
  "expo": {
    "name": "BADR_SUPPORT",
    "slug": "badr-support",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "badrsupport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "name": "BADR_SUPPORT",
      "shortName": "BADR",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "themeColor": "#080C10",
      "backgroundColor": "#080C10"
    },
    "android": {
      "package": "com.badrsupport.app"
    }
  }
}
